[Unit]
Description=Hello Sunshine security checks and existing admin email alerts
Wants=network-online.target
After=network-online.target
StartLimitIntervalSec=2h
StartLimitBurst=3

[Service]
Type=oneshot
User=hellosunshine
Group=hellosunshine
WorkingDirectory=/srv/hellosunshine/current
EnvironmentFile=/etc/hellosunshine/environment
Environment=NODE_ENV=production
StateDirectory=hellosunshine-security
StateDirectoryMode=0700
ExecStart=/usr/bin/node /usr/local/lib/hellosunshine-security/monitor.mjs
TimeoutStartSec=10min
Restart=on-failure
RestartSec=15min
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectHome=true
ProtectSystem=strict
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
CapabilityBoundingSet=
MemoryMax=512M
CPUQuota=50%
